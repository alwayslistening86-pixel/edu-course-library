{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "courses/<id>/question_bank.json (schema_version 1)",
  "type": "object",
  "required": ["schema_version", "questions"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "source_note": {"type": "string"},
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "stage_id", "marks", "prompt", "mark_scheme", "source"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "stage_id": {"type": "string", "minLength": 1},
          "item_ids": {"type": "array", "items": {"type": "string"}},
          "marks": {"type": "integer", "minimum": 1},
          "calculator": {"type": ["boolean", "null"]},
          "command_word": {"type": "string"},
          "difficulty": {"type": "integer", "minimum": 1, "maximum": 5},
          "prompt": {"type": "string", "minLength": 5},
          "mark_scheme": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "marks", "descriptor"],
              "properties": {
                "id": {"type": "string"},
                "marks": {"type": "integer", "minimum": 1},
                "type": {"enum": ["M", "A", "B", "C", "other"]},
                "descriptor": {"type": "string", "minLength": 3}
              }
            }
          },
          "model_answer": {"type": "string"},
          "key": {
            "type": "object",
            "required": ["kind"],
            "properties": {"kind": {"enum": ["mcq", "numeric", "short"]}},
            "description": "Optional machine-checkable answer key (B-02.3). tutorlib/marking.py defines the three shapes and checks them; a keyed question can be marked by mark_answer.py without a model."
          },
          "source": {"type": "string", "minLength": 3}
        }
      }
    }
  }
}
