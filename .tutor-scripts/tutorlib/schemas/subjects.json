{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "subjects/<course_id>.json (schema_version 5)",
  "type": "object",
  "required": [
    "schema_version",
    "course_id",
    "roster_state",
    "syllabus_status",
    "current_stage"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "course_id": {
      "type": "string",
      "minLength": 1
    },
    "roster_state": {
      "enum": [
        "active",
        "dormant",
        "test_pending_convergence",
        "dropped"
      ]
    },
    "cohort_id": {
      "type": [
        "integer",
        "string",
        "null"
      ]
    },
    "syllabus_status": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "pass",
          "fail",
          "unsat",
          "withheld"
        ]
      }
    },
    "notices_acknowledged": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "on": {
            "type": "string"
          }
        }
      }
    },
    "current_stage": {
      "type": [
        "string",
        "null"
      ]
    },
    "current_phase": {
      "enum": [
        "lesson",
        "practice",
        "test"
      ]
    },
    "exam_status": {
      "enum": [
        "locked",
        "available",
        "passed"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "error_patterns": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/error"
      }
    },
    "item_mastery": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "p_mastery"
        ],
        "properties": {
          "p_mastery": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "observations": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "remediation": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "attempts": {
            "type": "integer",
            "minimum": 0
          },
          "escalated": {
            "type": "boolean"
          }
        }
      }
    },
    "last_session_summary": {
      "type": "string"
    },
    "last_updated": {
      "type": "string"
    },
    "target": {
      "type": "object",
      "required": [
        "date"
      ],
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "set_on": {
          "type": "string"
        }
      }
    },
    "practice_used": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "fixed": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "generated": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "mock_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "date",
          "total_marks",
          "awarded"
        ],
        "properties": {
          "date": {
            "type": "string"
          },
          "total_marks": {
            "type": "integer",
            "minimum": 1
          },
          "awarded": {
            "type": "integer",
            "minimum": 0
          },
          "percent": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "minutes": {
            "type": "integer",
            "minimum": 0
          },
          "questions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "calibration": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "stage_id",
              "rating",
              "result",
              "on"
            ],
            "properties": {
              "stage_id": {
                "type": "string"
              },
              "rating": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "result": {
                "enum": [
                  "pass",
                  "fail"
                ]
              },
              "on": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "error": {
      "type": "object",
      "required": [
        "id",
        "stage_id",
        "source_phase",
        "cause",
        "slot",
        "resolved"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "stage_id": {
          "type": "string"
        },
        "item_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_phase": {
          "enum": [
            "practice",
            "test"
          ]
        },
        "cause": {
          "enum": [
            "slip",
            "missing_prerequisite",
            "misconception",
            "misapplied_procedure",
            "comprehension"
          ]
        },
        "misconception_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "rubric_criterion": {
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "slot": {
          "type": "integer",
          "minimum": 0
        },
        "resolved": {
          "type": "boolean"
        },
        "resolved_at_slot": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    }
  }
}
