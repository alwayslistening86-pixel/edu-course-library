  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "pattern",
      "correction",
      "source"
    ],
    "properties": {
      "pattern": {
        "type": "string",
        "minLength": 10
      },
      "correction": {
        "type": "string",
        "minLength": 10
      },
      "source": {
        "type": "string",
        "minLength": 5
      }
    }
  }
}
