{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "stages/<id>/misconceptions.json",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "pattern",
      "correction",
      "source"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,39}$",
        "description": "Optional stable id (for example MC-S1-1) that error_log.py checks a logged misconception_id against. Never renumber an id once learners' errors may carry it."
      },
      "pattern": {
        "type": "string",
        "minLength": 10
      },
      "correction": {
        "type": "string",
        "minLength": 10
      },
      "source": {
        "type": "string",
        "minLength": 5
      }
    }
  }
}
