{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "courses/access.json or <course>/access.json (written by confirm_access.py)",
  "type": "object",
  "required": ["status", "confirmed_on"],
  "properties": {
    "status": {"enum": ["isolated_confirmed", "shared_confirmed"]},
    "confirmed_on": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
  }
}
