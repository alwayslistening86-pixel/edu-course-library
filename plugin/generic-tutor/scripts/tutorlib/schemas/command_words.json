{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "command_words.json (optional, course root)",
  "type": "object",
  "required": ["source", "command_words"],
  "properties": {
    "source": {"type": "string", "minLength": 5},
    "command_words": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["word", "meaning", "earns_marks_by"],
        "properties": {
          "word": {"type": "string", "minLength": 2},
          "meaning": {"type": "string", "minLength": 10},
          "earns_marks_by": {"type": "string", "minLength": 10}
        }
      }
    }
  }
}
